module Crypto_Engine_256_Top (
  clk_d,
  n26_5,
  key_load_pulse,
  rst_n_d,
  start_pulse,
  read_addr,
  \key_regs[4] ,
  \key_regs[7] ,
  \key_regs[0] ,
  \key_regs[5] ,
  \key_regs[1] ,
  \key_regs[2] ,
  \key_regs[6] ,
  \key_regs[3] ,
  \data_in_regs[0] ,
  \data_in_regs[1] ,
  \data_in_regs[2] ,
  \data_in_regs[3] ,
  key_busy,
  key_ready,
  core_done,
  data_out_bus
)
;
input clk_d;
input n26_5;
input key_load_pulse;
input rst_n_d;
input start_pulse;
input [4:4] read_addr;
input [31:0] \key_regs[4] ;
input [31:0] \key_regs[7] ;
input [31:0] \key_regs[0] ;
input [31:0] \key_regs[5] ;
input [31:0] \key_regs[1] ;
input [31:0] \key_regs[2] ;
input [31:0] \key_regs[6] ;
input [31:0] \key_regs[3] ;
input [31:0] \data_in_regs[0] ;
input [31:0] \data_in_regs[1] ;
input [31:0] \data_in_regs[2] ;
input [31:0] \data_in_regs[3] ;
output key_busy;
output key_ready;
output core_done;
output [127:0] data_out_bus;
wire [127:0] round_key_Z;
wire [3:0] round_idx_Z;
wire VCC;
wire GND;
  aes256_key_schedule ks_inst (
    .clk_d(clk_d),
    .n26_5(n26_5),
    .key_load_pulse(key_load_pulse),
    .rst_n_d(rst_n_d),
    .round_idx_Z(round_idx_Z[3:0]),
    .read_addr(read_addr[4]),
    .\key_regs[4] (\key_regs[4] [31:0]),
    .\key_regs[7] (\key_regs[7] [31:0]),
    .\key_regs[0] (\key_regs[0] [31:0]),
    .\key_regs[5] (\key_regs[5] [31:0]),
    .\key_regs[1] (\key_regs[1] [31:0]),
    .\key_regs[2] (\key_regs[2] [31:0]),
    .\key_regs[6] (\key_regs[6] [31:0]),
    .\key_regs[3] (\key_regs[3] [31:0]),
    .key_busy(key_busy),
    .key_ready(key_ready),
    .round_key_Z(round_key_Z[127:0])
);
  AES256_serial_core core_inst (
    .clk_d(clk_d),
    .n26_5(n26_5),
    .key_ready(key_ready),
    .start_pulse(start_pulse),
    .read_addr(read_addr[4]),
    .\data_in_regs[0] (\data_in_regs[0] [31:0]),

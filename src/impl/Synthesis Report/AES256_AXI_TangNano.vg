module soc_top (
  clk,
  rst_n,
  uart_rx_pin,
  uart_tx_pin
)
;
input clk;
input rst_n;
input uart_rx_pin;
output uart_tx_pin;
wire clk_d;
wire rst_n_d;
wire uart_rx_pin_d;
wire uart_tx_pin_d;
wire ahb_hsel;
wire ahb_hwrite;
wire [6:0] ahb_haddr;
wire [1:1] ahb_htrans;
wire [31:0] ahb_hwdata;
wire [31:0] ahb_hrdata;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_n_ibuf (
    .O(rst_n_d),
    .I(rst_n) 
);
  IBUF uart_rx_pin_ibuf (
    .O(uart_rx_pin_d),
    .I(uart_rx_pin) 
);
  OBUF uart_tx_pin_obuf (
    .O(uart_tx_pin),
    .I(uart_tx_pin_d) 
);
  Gowin_EMPU_Top mcu_inst (
    .rst_n_d(rst_n_d),
    .clk_d(clk_d),
    .uart_rx_pin_d(uart_rx_pin_d),
    .ahb_hrdata(ahb_hrdata[31:0]),
    .uart_tx_pin_d(uart_tx_pin_d),
    .ahb_hsel(ahb_hsel),
    .ahb_hwrite(ahb_hwrite),
    .ahb_haddr(ahb_haddr[6:0]),
    .ahb_htrans(ahb_htrans[1]),
    .ahb_hwdata(ahb_hwdata[31:0])
);
  ahb_lite_aes256_wrapper aes_hw (
    .clk_d(clk_d),
    .ahb_hwrite(ahb_hwrite),
    .ahb_hsel(ahb_hsel),
    .rst_n_d(rst_n_d),
    .ahb_haddr(ahb_haddr[6:0]),
    .ahb_hwdata(ahb_hwdata[31:0]),
    .ahb_htrans(ahb_htrans[1]),
    .ahb_hrdata(ahb_hrdata[31:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* soc_top */
